# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/perfume_erp?schema=public"

# Authentication
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shopify — Chunk 4
# Client ID/secret of the custom/private app (Partner Dashboard → App setup).
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Public URL Shopify redirects back to after OAuth, e.g. https://your-app.example.com
SHOPIFY_APP_URL=""
# HMAC secret used to verify incoming webhook payloads. Falls back to
# SHOPIFY_API_SECRET when unset (Shopify signs webhooks with the app's
# client secret unless a distinct webhook signing secret was issued).
SHOPIFY_WEBHOOK_SECRET=""
# OAuth scopes requested at install time (comma-separated, no spaces).
SHOPIFY_SCOPES="read_products,read_orders,read_returns"
# Admin API version to call. Verify against https://shopify.dev/docs/api/admin-graphql
# at deploy time — Shopify ships a new stable version every 3 months.
SHOPIFY_API_VERSION="2026-07"
# 32-byte key (base64) used to encrypt the stored Shopify access token at rest.
# Generate with: openssl rand -base64 32
SHOPIFY_TOKEN_ENCRYPTION_KEY=""
